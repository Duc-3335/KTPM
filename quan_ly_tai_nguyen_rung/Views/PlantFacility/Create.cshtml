@using quan_ly_tai_nguyen_rung.ViewModels
@model PlantFacilityViewModel

<form method="post" asp-action="Create" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Name">Tên cơ sở</label>
        <input asp-for="Name" class="form-control" placeholder="Nhập tên cơ sở">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status">Trạng thái</label>
        <select asp-for="Status" class="form-control">
            <option value="true">Bật</option>
            <option value="false">Tắt</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Address">Địa chỉ</label>
        <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ cơ sở">
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ContactFace">Người liên hệ</label>
        <input asp-for="ContactFace" class="form-control" placeholder="Nhập người liên hệ">
        <span asp-validation-for="ContactFace" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ContactMail">Email liên hệ</label>
        <input asp-for="ContactMail" class="form-control" placeholder="Nhập email liên hệ">
        <span asp-validation-for="ContactMail" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ContactPhone">Số điện thoại</label>
        <input asp-for="ContactPhone" class="form-control" placeholder="Nhập số điện thoại liên hệ">
        <span asp-validation-for="ContactPhone" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Labor">Số lao động</label>
        <input asp-for="Labor" class="form-control" placeholder="Nhập số lao động" />
        <span asp-validation-for="Labor" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Acreage">Diện tích</label>
        <input asp-for="Acreage" class="form-control" placeholder="Nhập diện tích">
        <span asp-validation-for="Acreage" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CommuneId" class="control-label">Xã</label>
        <select asp-for="CommuneId" asp-items="ViewBag.Communes" class="form-control">
            <option value="">-- Chọn xã --</option>
        </select>
        <span asp-validation-for="CommuneId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ImagePlantBreedingFacility">Ảnh cơ sở</label>
        <input asp-for="ImagePlantBreedingFacility" type="file" class="form-control" />
        <span asp-validation-for="ImagePlantBreedingFacility" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
</form>

<a href="@Url.Action("Index", "PlantFacility")" class="btn btn-secondary mt-3">Trở lại</a>
