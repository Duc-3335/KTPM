@model quan_ly_tai_nguyen_rung.Models.section2.PlantFacility

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.12.1/css/all.min.css" integrity="sha256-mmgLkCYLUQbXn0B1SRqzHar6dCnv9oZFPEC1g1cwlkk=" crossorigin="anonymous" />
<div class="container">
    <div class="row">
        <div class="col-md-5">
            <div class="project-info-box mt-0">
                <h5>DETAILS</h5>
                <p class="mb-0">Thông tin chi tiết về cơ sở trồng cây</p>
            </div><!-- / project-info-box -->

            <div class="project-info-box">
                <p><b>Tên cơ sở:</b> @Model.Name</p>
                <p><b>Diện tích:</b> @Model.Acreage <b>km²</b></p>
                <p><b>Số lao động:</b> @Model.Labor</p>
                <p><b>Thuộc xã:</b> @Model.Commune.Name</p>
                <p class="mb-0"><b>Địa chỉ:</b> @Model.Address</p>
                <p class="mb-0"><b>Email:</b> @Model.ContactMail</p>
                <p class="mb-0"><b>Số điện thoại:</b> @Model.ContactPhone</p>
            </div><!-- / project-info-box -->

            <div class="project-info-box mt-0 mb-0">
                <p class="mb-0">
                    <span class="fw-bold mr-10 va-middle hide-mobile">Chia sẻ:</span>
                    <a href="#x" class="btn btn-xs btn-facebook btn-circle btn-icon mr-5 mb-0"><i class="fab fa-facebook-f"></i></a>
                    <a href="#x" class="btn btn-xs btn-twitter btn-circle btn-icon mr-5 mb-0"><i class="fab fa-twitter"></i></a>
                    <a href="#x" class="btn btn-xs btn-pinterest btn-circle btn-icon mr-5 mb-0"><i class="fab fa-pinterest"></i></a>
                    <a href="#x" class="btn btn-xs btn-linkedin btn-circle btn-icon mr-5 mb-0"><i class="fab fa-linkedin-in"></i></a>
                </p>
            </div><!-- / project-info-box -->
        </div><!-- / column -->

        <div class="col-md-7">
            <!-- Displaying the plant image -->
            @if (!string.IsNullOrEmpty(Model.ImagePlantBreedingFacility))
            {
                <img src="@Model.ImagePlantBreedingFacility" alt="project-image" class="rounded img-fluid">
            }
            else
            {
                <p>No image available.</p>
            }
            <div class="project-info-box">
                <p><b>Categories:</b> Agriculture, Plant Breeding</p>
                <p><b>Skills:</b> Plant Management</p>
            </div><!-- / project-info-box -->
        </div><!-- / column -->
    </div>
</div>
