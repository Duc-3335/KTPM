@model IEnumerable<quan_ly_tai_nguyen_rung.Models.section4.Animal>

<div class="album py-5 bg-body-tertiary">
    <div class="container">
        @using (Html.BeginForm("SearchByName", "Animal", FormMethod.Get))
        {
            <div class="row">
                <div class="col-md-8">
                    <input type="text" name="name" class="form-control" placeholder="Nhập tên động vật" value="@ViewContext.HttpContext.Request.Query["name"]" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                </div>
            </div>
        }
        <a type="btn btn-success" asp-controller="Animal" asp-action="Create" class="btn btn-sm btn-success mb-3">Create</a>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <p class="card-text">@item.Name</p>
                            <p class="card-text">Generic: @item.Generic</p>
                            <p class="card-text">Date Found: @item.DateFound.ToShortDateString()</p>
                            <p class="card-text">Previous Quantity: @item.PreviousQuantity</p>
                            <p class="card-text">Current Quantity: @item.CurrentQuantity</p>
                            <p class="card-text">Status: @item.Status</p>
                            <p class="card-text">Has Fluctuation: @item.HasFluctuation</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <a type="btn btn-success" asp-controller="Animal" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                    <a type="btn btn-success" asp-controller="Animal" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a type="btn btn-success" asp-controller="Animal" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Delete</a>
                                </div>
                                <small class="text-body-secondary">@item.DateFound.ToShortDateString()</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
