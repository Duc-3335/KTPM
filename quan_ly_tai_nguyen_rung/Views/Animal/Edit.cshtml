@using quan_ly_tai_nguyen_rung.ViewModel.section4
@model AnimalViewModel

@{
    ViewData["Title"] = "Chỉnh sửa thông tin động vật";
}

<h2>Chỉnh sửa thông tin</h2>

<form method="post" asp-action="Edit">
    <input type="hidden" asp-for="Id" /> <!-- Ẩn Id để truyền vào khi submit -->

    <div class="form-group">
        <label asp-for="Name">Tên</label>
        <input asp-for="Name" class="form-control" placeholder="Nhập tên động vật" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Generic">Chủng loại</label>
        <select asp-for="Generic" asp-items="@Html.GetEnumSelectList<quan_ly_tai_nguyen_rung.DATA.@enum.generic>()" class="form-control">
            <option value="">--Chọn loại--</option>
        </select>
        <span asp-validation-for="Generic" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateFound">Ngày tìm thấy</label>
        <input asp-for="DateFound" type="date" class="form-control" />
        <span asp-validation-for="DateFound" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PreviousQuantity">Số lượng ban đầu</label>
        <input asp-for="PreviousQuantity" type="number" class="form-control" />
        <span asp-validation-for="PreviousQuantity" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CurrentQuantity">Số lượng hiện tại</label>
        <input asp-for="CurrentQuantity" type="number" class="form-control" />
        <span asp-validation-for="CurrentQuantity" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status">Trạng thái</label>
        <select asp-for="Status" asp-items="@Html.GetEnumSelectList<quan_ly_tai_nguyen_rung.DATA.@enum.status>()" class="form-control">
            <option value="">--Chọn trạng thái--</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="HasFluctuation">Có biến động</label>
        <select asp-for="HasFluctuation" class="form-control">
            <option value="">--Chọn--</option>
            <option value="true">Có</option>
            <option value="false">Không</option>
        </select>
        <span asp-validation-for="HasFluctuation" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="AnimalFacilityId">Cơ sở động vật</label>
        <input asp-for="AnimalFacilityId" type="number" class="form-control" placeholder="Nhập ID cơ sở động vật" />
        <span asp-validation-for="AnimalFacilityId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Hủy</a>
</form>
