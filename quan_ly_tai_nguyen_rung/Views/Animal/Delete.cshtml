@using quan_ly_tai_nguyen_rung.Models.section4
@model Animal

@{
    ViewData["Title"] = "Xác nhận xóa động vật";
}

<h1>Xác nhận xóa</h1>
<p>Bạn có chắc chắn muốn xóa thông tin này không?</p>

<form method="post" asp-action="Delete">
    <input type="hidden" name="facilityId" value="@ViewBag.FacilityId" />
    
    <div class="form-group">
        <label asp-for="Name">Tên động vật</label>
        <input asp-for="Name" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Generic">Chủng loại</label>
        <input asp-for="Generic" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="DateFound">Ngày tìm thấy</label>
        <input asp-for="DateFound" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="PreviousQuantity">Số lượng ban đầu</label>
        <input asp-for="PreviousQuantity" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="CurrentQuantity">Số lượng hiện tại</label>
        <input asp-for="CurrentQuantity" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Status">Trạng thái</label>
        <input asp-for="Status" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="AnimalFacilityId">Cơ sở động vật</label>
        <input asp-for="AnimalFacilityId" class="form-control" readonly />
    </div>

    <div class="form-group">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Xác nhận</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>
