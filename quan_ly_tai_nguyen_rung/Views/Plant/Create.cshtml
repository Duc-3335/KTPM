@model quan_ly_tai_nguyen_rung.Models.ViewModels.PlantViewModel

@{
    ViewData["Title"] = "Create Plant";
}

<h2>Create Plant</h2>

<form asp-action="Create" method="post">
    <input type="hidden" name="facilityId" value="@ViewBag.FacilityId" />
    <div class="form-group">
        <label asp-for="Name">Tên cây</label>
        <input asp-for="Name" class="form-control" placeholder="Nhập tên cây">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="type">Loại cây</label>
        <select asp-for="type" asp-items="ViewBag.PlantTypeOptions" class="form-control">
            <option value="">--Chọn loại cây--</option>
        </select>
        <span asp-validation-for="type" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price">Giá</label>
        <input asp-for="Price" type="number" class="form-control" placeholder="Nhập giá">
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Height">Chiều cao</label>
        <input asp-for="Height" type="number" class="form-control" placeholder="Nhập chiều cao">
        <span asp-validation-for="Height" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
