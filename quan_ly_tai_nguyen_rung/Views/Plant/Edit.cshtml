@model quan_ly_tai_nguyen_rung.Models.ViewModels.PlantViewModel

@{
    ViewData["Title"] = "Chỉnh sửa thông tin cây trồng";
}

<h2>Chỉnh sửa thông tin cây trồng</h2>

<form method="post" asp-action="Edit">
    <input type="hidden" asp-for="ID" /> <!-- Truyền ID vào form dưới dạng ẩn -->
    <input type="hidden" name="facilityId" value="@ViewBag.FacilityId" />
    <div class="form-group">
        <label asp-for="Name">Tên cây</label>
        <input asp-for="Name" class="form-control" placeholder="Nhập tên cây" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="type">Loại cây</label>
        <select asp-for="type" asp-items="@Html.GetEnumSelectList<quan_ly_tai_nguyen_rung.DATA.@enum.type_plant>()" class="form-control">
            <option value="">--Chọn loại cây--</option>
        </select>
        <span asp-validation-for="type" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price">Giá bán (VNĐ)</label>
        <input asp-for="Price" type="number" class="form-control" placeholder="Nhập giá bán" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Height">Chiều cao (cm)</label>
        <input asp-for="Height" type="number" class="form-control" placeholder="Nhập chiều cao" />
        <span asp-validation-for="Height" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Hủy</a>
</form>
