@model quan_ly_tai_nguyen_rung.Models.Fluctuation

<h2>Xóa Biến Động</h2>
<p>Bạn có chắc chắn muốn xóa biến động sau không?</p>

<dl class="row">
    <dt class="col-sm-2">Năm</dt>
    <dd class="col-sm-10">@Model.Year</dd>
    <dt class="col-sm-2">Tháng</dt>
    <dd class="col-sm-10">@Model.Month</dd>
    <dt class="col-sm-2">Số lượng thay đổi</dt>
    <dd class="col-sm-10">@Model.QuantityChange</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" name="facilityId" value="@ViewBag.FacilityId" />
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" asp-route-facilityId="@ViewBag.FacilityId" class="btn btn-secondary">Hủy</a>
</form>
