@model quan_ly_tai_nguyen_rung.ViewModel.FluctuationViewModel

<h2>Chỉnh sửa Biến Động</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" name="facilityId" value="@ViewBag.FacilityId" />
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Year">Năm</label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Month">Tháng</label>
        <input asp-for="Month" class="form-control" />
        <span asp-validation-for="Month" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Quarter">Quý</label>
        <input asp-for="Quarter" class="form-control" />
        <span asp-validation-for="Quarter" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Type">Loại Biến Động</label>
        <select asp-for="Type" class="form-control">
            <option value="true">Tăng</option>
            <option value="false">Giảm</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="AnimalId">Động vật</label>
        <select asp-for="AnimalId" asp-items="ViewBag.Animal" class="form-control"></select>
        <span asp-validation-for="AnimalId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="QuantityChange">Số lượng thay đổi</label>
        <input asp-for="QuantityChange" class="form-control" />
        <span asp-validation-for="QuantityChange" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Reason">Lý do</label>
        <textarea asp-for="Reason" class="form-control"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>
    <!-- Form fields giống Create.cshtml -->
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" asp-route-facilityId="@ViewBag.FacilityId" class="btn btn-secondary">Trở lại</a>
</form>
