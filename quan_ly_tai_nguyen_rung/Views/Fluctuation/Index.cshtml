@model quan_ly_tai_nguyen_rung.ViewModel.FluctuationStatisticViewModel

<h2>Danh sách Biến Động</h2>

<a asp-action="Create" asp-route-facilityId="@Model.FacilityId" class="btn btn-success mb-3">Thêm mới</a>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Năm</th>
            <th>Quý</th>
            <th>Tháng</th>
            <th>Động vật</th>
            <th>Số lượng thay đổi</th>
            <th>Lý do</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var yearData in Model.YearlyData)
        {
            foreach (var quarterData in yearData.QuarterlyData)
            {
                foreach (var monthData in quarterData.MonthlyData)
                {
                    foreach (var detail in monthData.FluctuationDetails)
                    {
                        <tr>
                            <td>@yearData.Year</td>
                            <td>@quarterData.Quarter</td>
                            <td>@monthData.Month</td>
                            <td>@detail.AnimalName</td>
                            <td>@detail.QuantityChange</td>
                            <td>@string.Join(", ", detail.Reasons)</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@detail.id" asp-route-facilityId="@ViewBag.FacilityId" class="btn btn-warning btn-sm">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@detail.id" asp-route-facilityId="@ViewBag.FacilityId" class="btn btn-danger btn-sm">Xóa</a>
                            </td>
                        </tr>
                    }
                }
            }
        }
    </tbody>
</table>
